PORT=3000
HOST=127.0.0.1
OPENAI_API_KEY=
OPENAI_ROUTING_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-live-transcribe
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
EIDOS_MOCK=false
VITE_EIDOS_MOCK=false
VITE_EIDOS_DEBUG=true
VITE_FACE_MODEL_URL=https://storage.googleapis.com/mediapipe-models/face_detector/blaze_face_short_range/float16/1/blaze_face_short_range.tflite
VITE_FACE_WASM_URL=/mediapipe/wasm
VITE_API_BASE_URL=

# Optional photo sharing. Keep the bucket private; the local server uploads
# photos and returns a temporary signed download URL for the QR code.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=eidos
PHOTO_URL_TTL_SECONDS=3600
VITE_GESTURE_MODEL_URL=https://storage.googleapis.com/mediapipe-models/gesture_recognizer/gesture_recognizer/float16/1/gesture_recognizer.task
